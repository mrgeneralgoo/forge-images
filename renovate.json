{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mrgeneralgoo/renovate-config:public"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)mapservice-build\\/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-tags depName=ladislav-zezula/StormLib\\s+ARG STORMLIB_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ladislav-zezula/StormLib",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "ladislav-zezula/StormLib"
      ],
      "automerge": false,
      "matchManagers": [
        "custom.regex"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "golang",
        "sqlc/sqlc",
        "wordpress",
        "library/wordpress",
        "serversideup/php"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": false
    }
  ]
}
