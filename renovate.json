{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Shanghai",
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "allowedCommands": [
    "^bash mapservice-build/update-stormlib-pin\\.sh v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)mapservice-build\\/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-tags depName=ladislav-zezula/StormLib\\s+ARG STORMLIB_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ladislav-zezula/StormLib",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "ladislav-zezula/StormLib"
      ],
      "automerge": false,
      "matchManagers": [
        "custom.regex"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bash mapservice-build/update-stormlib-pin.sh {{{newValue}}}"
        ],
        "fileFilters": [
          "mapservice-build/Dockerfile"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "automerge": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "golang",
        "sqlc/sqlc",
        "golangci/golangci-lint",
        "wordpress",
        "library/wordpress",
        "serversideup/php"
      ],
      "automerge": false
    }
  ]
}
